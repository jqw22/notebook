# Ignore peer-dependency conflicts during resolution.
#
# npm's arborist crashes with a null dereference -- "Cannot read properties of
# null (reading 'edgesOut')" in build-ideal-tree.js (#loadPeerSet) -- while
# resolving this project's dependency graph. Because no package-lock.json is
# committed and node_modules is absent, every CI run re-resolves the full tree
# from the registry against the "^" ranges, which is non-deterministic and can
# trigger the crash with no change to this repo.
#
# Resolving without the peer set avoids the crash. This .npmrc applies to every
# npm command run in the project, including the `npm i` inside the "build"
# script, so a single setting covers all install steps.
#
# See npm/cli#5151 and npm/cli#6492.
legacy-peer-deps=true
